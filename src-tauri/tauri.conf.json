{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskMate",
  "version": "0.2.0",
  "identifier": "com.cjxhaaa.diskmate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskMate",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RUZGQjk2QTRDREUxRTQKUldUazRjMmtsdnZ2QklpNG55cEdiNGMrR3ovRW85Vi8wSnh3a2JsYTRaV0JvdDVDd0FLYStnNFgK",
      "endpoints": ["https://github.com/cjxhaaa/diskmate/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
